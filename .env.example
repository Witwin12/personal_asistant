# ==========================================
# AI & LLM Configuration (Google AI Studio)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ==========================================
# Text-to-Speech (TTS) Configuration
# ==========================================
# เลือกผู้ให้บริการเสียงพูด:
# - "edge-tts"   (ฟรี 100% ไม่ใช้คีย์ เสียงเป็นธรรมชาติจาก Microsoft)
# - "gtts"       (ฟรี 100% ไม่ใช้คีย์ เสียง Google Translate ภาษาไทย)
# - "gemini"     (ฟรีตามโควต้า Google AI Studio ใช้ GEMINI_API_KEY เดียวกันได้เลย!)
# - "botnoi"     (มี Free Tier พอยต์ฟรีเมื่อสมัครที่ https://voice.botnoi.ai)
# - "aiforthai"  (ฟรี API Key จาก NECTEC ประเทศไทย https://aiforthai.in.th)
# - "elevenlabs" (มี Free Tier 10,000 ตัวอักษร/เดือน)
TTS_PROVIDER=edge-tts

# 1. สำหรับ Edge-TTS (ฟรี: th-TH-PremwadeeNeural หญิง / th-TH-NiwatNeural ชาย)
EDGE_TTS_VOICE=th-TH-PremwadeeNeural
EDGE_TTS_RATE=+0%

# 2. สำหรับ Gemini TTS (ฟรีด้วย GEMINI_API_KEY เดียวกับข้างบน! เสียงแนะนำ: Kore, Aoede, Puck, Zephyr)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# 3. สำหรับ Botnoi Voice (สมัครรับคีย์ฟรีที่ https://voice.botnoi.ai)
BOTNOI_API_KEY=your_botnoi_api_key_here
BOTNOI_SPEAKER_ID=1

# 4. สำหรับ AI for Thai - VAJA9 (สมัครรับคีย์ฟรีที่ https://aiforthai.in.th)
AIFORTHAI_API_KEY=your_aiforthai_api_key_here

# 5. สำหรับ ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ==========================================
# Speech-to-Text (STT) & Microphone Config
# ==========================================
STT_LANGUAGE=th-TH
LISTEN_TIMEOUT=5
PHRASE_TIME_LIMIT=10

# ==========================================
# System / OS Actions Config
# ==========================================
WORKSPACE_DIR=./workspace
